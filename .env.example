# ============================================================
# Telegram Cargo Forwarder — Muhit sozlamalari (Environment Template)
# Ushbu fayldan nusxa olib, .env nomi bilan saqlang va kerakli qiymatlarni to'ldiring.
# ============================================================

# --- Userbot (Telethon) sozlamalari (my.telegram.org dan olinadi) ---
API_ID=12345678
API_HASH=your_telegram_api_hash

# Telethon session nomi (lokal / docker volume uchun)
TELETHON_SESSION_NAME=sessions/userbot_session

# Telethon String Session (Render yoki boshqa serverlarda faylsiz ishlash uchun ixtiyoriy)
# 'python -m scripts.generate_string_session' orqali olinadi
TELETHON_STRING_SESSION=

# --- Bot API sozlamalari (@BotFather dan olinadi) ---
BOT_TOKEN=1234567890:ABCdefGHIjklMNOpqrSTUvwxYZ
BOT_USERNAME=YourBotUsername_bot

# --- Guruhlar ---
# Asosiy guruh (barcha filtrlangan xabarlar yuboriladigan guruh ID si)
MAIN_GROUP_ID=-1001234567890

# Manba guruh va kanallar (vergul bilan ajratilgan)
SOURCE_CHATS=https://t.me/guruh1,https://t.me/guruh2

# --- Adminlar ---
# Telegram ID raqamlari (vergul bilan ajratilgan)
ADMIN_IDS=123456789,987654321

# --- Ma'lumotlar bazasi (PostgreSQL) ---
DATABASE_URL=postgresql+psycopg2://cargo_user:cargo_pass@localhost:5432/cargo_db
POSTGRES_USER=cargo_user
POSTGRES_PASSWORD=cargo_pass
POSTGRES_DB=cargo_db

# --- Redis (Pub/Sub va Deduplication) ---
REDIS_URL=redis://localhost:6379/0

# --- Boshqa sozlamalar ---
MESSAGE_RETENTION_DAYS=30
LOG_LEVEL=INFO
TIMEZONE=Asia/Tashkent
